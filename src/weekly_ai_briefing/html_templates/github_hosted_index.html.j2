{% extends "github_hosted_base.html.j2" %}
{% block extra_style %}
.editions { list-style: none; padding: 0; }
.editions li { display: grid; grid-template-columns: 7rem 1fr 3rem; gap: 0 1rem; padding: 0.75rem 0; border-top: 1px solid #8884; }
.editions p { margin: 0.25rem 0 0; }
.editions .icons { text-align: right; }
@media (max-width: 30rem) {
  .editions li { grid-template-columns: 1fr auto; }
  .editions time { grid-column: 1 / -1; }
}
{% endblock %}
{% block body %}
<h1>{{ title }}</h1>
<ul class="editions">
{% for edition in editions %}
<li><time datetime="{{ edition.date }}">{{ edition.date }}</time><div><a href="{{ html_folder }}/{{ edition.briefing_stem }}.html">{{ edition.title }}</a><p>{{ edition.summary }}</p></div><span class="icons">{% if edition.has_audio %}<span role="img" aria-label="Includes embedded audio" title="Includes embedded audio">&#128266;</span>{% endif %}</span></li>
{% endfor %}
</ul>
{% endblock %}
